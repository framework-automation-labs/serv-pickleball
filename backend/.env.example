PORT=5000
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used to build the QR-code link embedded in downloadable PDF receipts,
# and the links inside emails (should be the deployed frontend URL,
# e.g. your GitHub Pages URL)
FRONTEND_URL=http://localhost:5173

# --- Email (optional) ---
# If any of these are missing, the app just skips sending emails and
# logs a warning — nothing breaks. Works with any SMTP provider,
# including a Gmail account + an "app password" (not your normal
# password): https://support.google.com/mail/answer/185833
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="SERV Pickleball Club <your-email@gmail.com>"

# Sent an instant heads-up whenever a new receipt needs review, so you
# don't have to keep the dashboard open to catch it quickly. Leave
# blank to disable.
ADMIN_NOTIFICATION_EMAIL=owner@example.com

# Comma-separated list of frontend ORIGINS allowed to call this API
# (scheme + host only: no path, no trailing slash). REQUIRED in
# production. When blank the API only accepts localhost origins, so
# a deployed site would be blocked until you set it, e.g.:
# ALLOWED_ORIGINS=https://yourusername.github.io
ALLOWED_ORIGINS=

# Set to 1 when the API runs behind a reverse proxy / PaaS (Render,
# Railway, Fly, Heroku, nginx...) so rate limiting uses the real client
# IP. Leave blank when running directly on the internet or locally.
TRUST_PROXY=

NODE_ENV=production

# How many hours a receipt can sit unreviewed before it's
# auto-rejected and its slot freed up. There's no payment gateway, so
# this is what stops an abandoned/fake submission from locking a court
# or tournament spot forever.
STALE_PENDING_HOURS=48
